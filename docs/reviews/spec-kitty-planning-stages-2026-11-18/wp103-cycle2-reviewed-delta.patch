+            f"dependencies: {json.dumps(dependencies)}\nowned_files: [{owned}]\nauthoritative_surface: {owned}\n"
+            "planning_base_branch: release/test\nmerge_target_branch: release/test\nsubtasks: []\nhistory: []\n---\n# Fixture\n"
+        )
+    mission_id = "01AAAAAAAAAAAAAAAAAAAAAAAB"
+    (mission / "meta.json").write_text(
+        json.dumps(
+            {
+                "mission_slug": "stages",
+                "mission_id": mission_id,
+                "mission_type": "software-dev",
