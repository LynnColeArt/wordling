+from specify_cli.workspace.context import clear_workspace_resolution_caches
+
+pytestmark = [pytest.mark.integration, pytest.mark.git_repo, pytest.mark.fast]
+
+
+def _git(root: Path, *args: str) -> str:
+    return subprocess.run(["git", *args], cwd=root, check=True, capture_output=True, text=True).stdout.strip()
+
+
+@pytest.fixture
+def public_stage_mission(tmp_path: Path) -> Iterator[tuple[Path, LanesManifest]]:
+    root = tmp_path
+    (root / ".kittify").mkdir()
+    (root / ".kittify/config.yaml").write_text("project:\n  uuid: 12345678-1234-5678-1234-567812345678\n")
+    mission = root / "kitty-specs/stages"
+    (mission / "tasks").mkdir(parents=True)
+    (root / "src").mkdir()
+    graph = {"WP01": [], "WP02": ["WP01"], "WP03": ["WP02"]}
+    owners = {}
+    for wp, dependencies in graph.items():
+        mode = WorkProductKind.PLANNING_ARTIFACT if wp != "WP02" else WorkProductKind.CODE_CHANGE
