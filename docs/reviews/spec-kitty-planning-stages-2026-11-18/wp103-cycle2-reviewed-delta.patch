+"""Keep actual planning-stage context on generic branch-target consumers.
+
+The bounded inventory distinguishes generic lane consumers from the existing
+code-only exits and contextless seams. Source floors and mutation tests prevent
+this gate from silently overlooking the reviewed omission class.
+"""
+
+from __future__ import annotations
+
+import ast
+from copy import deepcopy
+from pathlib import Path
+
+from tests.architectural.test_ratchet_baselines import _load_baselines
+
+import pytest
+
+pytestmark = pytest.mark.architectural
+_ROOT = Path(__file__).resolve().parents[2]
+_SRC = _ROOT / "src"
+
+# String-only exception counts are governed by the canonical _baselines.yaml ratchet.
+_CODE_ONLY = {
+    (
+        "specify_cli/workspace/context.py",
+        "_resolve_workspace_for_wp_impl",
+    ): "Root planning resolution has already returned; the later semantic planning contradiction raises before code naming.",
+    (
+        "specify_cli/merge/executor.py",
+        "_phase_cleanup_worktrees_and_branches",
+    ): "Branch cleanup explicitly continues for every semantic planning stage before this call.",
+    (
+        "specify_cli/orchestrator_api/commands.py",
+        "_apply_lane_merge_cleanup",
+    ): "Lane branch deletion skips semantic planning records, preserving the shared target.",
+    (
+        "specify_cli/cli/commands/mission_type.py",
+        "_expected_discard_branches",
+    ): "The discard verification inventory excludes planning targets with the same semantic exit as deletion.",
+    ("specify_cli/cli/commands/mission_type.py", "_delete_lane_branches"): "Discard deletion excludes every semantic planning stage before naming a code branch.",
+}
+
+_CONTEXTLESS = {
+    (
+        "specify_cli/lanes/branch_naming.py",
+        "worktree_dir_name",
+    ): "Code workspace grammar accepts no lane record; secondary planning names refuse in the branch seam.",
+    (
+        "specify_cli/lanes/worktree_allocator.py",
+        "predict_lane_worktree",
+    ): "Public code allocation prediction accepts an identifier; planning names refuse before effects.",
+    (
+        "specify_cli/migration/backfill_ownership.py",
+        "backfill_ownership",
+    ): "Incomplete historical ownership only: best-effort diff catches refusal; complete authored records skip this path.",
+}
+
+
+def _branch_call(node: ast.Call, aliases: set[str]) -> bool:
+    return (isinstance(node.func, ast.Name) and node.func.id in aliases) or (isinstance(node.func, ast.Attribute) and node.func.attr == "lane_branch_name")
+
+
+def _guarded_code_call(owner: ast.FunctionDef | ast.AsyncFunctionDef, call: ast.Call) -> bool:
+    lane_id = call.args[1] if len(call.args) > 1 else next((kw.value for kw in call.keywords if kw.arg == "lane_id"), None)
+    if not isinstance(lane_id, ast.Attribute) or not isinstance(lane_id.value, ast.Name):
+        return False
+    for node in ast.walk(owner):
+        if not isinstance(node, ast.If) or node.lineno >= call.lineno:
+            continue
+        test = node.test
+        if (
+            isinstance(test, ast.Call)
+            and isinstance(test.func, ast.Name)
+            and test.func.id == "is_planning_lane"
+            and len(test.args) == 1
+            and isinstance(test.args[0], ast.Name)
+            and test.args[0].id == lane_id.value.id
+            and any(isinstance(exit_node, (ast.Continue, ast.Raise)) for exit_node in node.body)
+        ):
+            return True
+    return False
+
+
+def _inspect(path: str, tree: ast.Module) -> tuple[list[str], int, int]:
+    aliases = {"lane_branch_name"}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom) and node.module == "specify_cli.lanes.branch_naming":
+            aliases.update(item.asname or item.name for item in node.names if item.name == "lane_branch_name")
+    errors: list[str] = []
+    total = typed = 0
+    seen_untyped: dict[tuple[str, str], int] = {}
+    owners: list[ast.FunctionDef | ast.AsyncFunctionDef] = []
+
+    class Visitor(ast.NodeVisitor):
+        def visit_FunctionDef(self, node: ast.FunctionDef | ast.AsyncFunctionDef) -> None:
+            owners.append(node)
+            self.generic_visit(node)
+            owners.pop()
+
+        visit_AsyncFunctionDef = visit_FunctionDef
+
+        def visit_Call(self, node: ast.Call) -> None:
+            nonlocal total, typed
+            if _branch_call(node, aliases):
+                total += 1
+                context = next((kw.value for kw in node.keywords if kw.arg == "lane"), None)
+                if context is not None and not (isinstance(context, ast.Constant) and context.value is None):
+                    typed += 1
+                else:
+                    scope = ".".join(owner.name for owner in owners)
+                    site = (path, scope)
+                    seen_untyped[site] = seen_untyped.get(site, 0) + 1
+                    if site not in _CONTEXTLESS and not (site in _CODE_ONLY and owners and _guarded_code_call(owners[-1], node)):
+                        errors.append(f"{path}:{node.lineno}:{scope}: missing actual typed lane context or semantic code-only exit")
+                    if seen_untyped[site] > 1:
+                        errors.append(f"{path}:{node.lineno}:{scope}: string-only exception grew")
+            self.generic_visit(node)
+
+    Visitor().visit(tree)
+    return errors, total, typed
+
+
+def test_live_generic_consumers_keep_typed_context_with_nonvacuous_floors() -> None:
+    errors: list[str] = []
+    total = typed = 0
+    for path in sorted(_SRC.rglob("*.py")):
+        found, count, typed_count = _inspect(path.relative_to(_SRC).as_posix(), ast.parse(path.read_text()))
+        errors.extend(found)
+        total += count
+        typed += typed_count
+    assert not errors, "\n".join(errors)
+    assert total >= 17, "The gate must continue to discover the real branch-consumer surface"
+    assert typed >= 9, "The generic typed consumer surface must remain visible"
+
+
+@pytest.mark.parametrize("path", ["specify_cli/context/resolver.py", "specify_cli/core/worktree_topology.py"])
+def test_removing_real_generic_lane_context_is_detected(path: str) -> None:
+    tree = deepcopy(ast.parse((_SRC / path).read_text()))
+    calls = [node for node in ast.walk(tree) if isinstance(node, ast.Call) and _branch_call(node, {"lane_branch_name"})]
+    assert len(calls) == 1
+    call = calls[0]
+    if not any(kw.arg == "lane" for kw in call.keywords):
+        lane_id = call.args[1]
+        assert isinstance(lane_id, ast.Attribute)
+        call.keywords.append(ast.keyword(arg="lane", value=deepcopy(lane_id.value)))
+    assert _inspect(path, tree) == ([], 1, 1)
+    call.keywords = [kw for kw in call.keywords if kw.arg != "lane"]
+    errors, count, typed = _inspect(path, tree)
+    assert count == 1 and typed == 0
+    assert len(errors) == 1 and "missing actual typed lane context" in errors[0]
+
+
+def test_code_only_exception_requires_its_actual_semantic_exit() -> None:
+    path = "specify_cli/cli/commands/mission_type.py"
+    tree = ast.parse((_SRC / path).read_text())
+    assert _inspect(path, tree)[0] == []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == "is_planning_lane":
+            node.func.id = "unrelated_predicate"
+    errors, _, _ = _inspect(path, tree)
+    assert len(errors) == 2
+    assert all("semantic code-only exit" in error for error in errors)
+
+
+def test_aliased_generic_call_cannot_hide_without_context() -> None:
+    tree = ast.parse(
+        "from specify_cli.lanes.branch_naming import lane_branch_name as branch_for\ndef generic(lane):\n    return branch_for('mission', lane.lane_id)\n"
+    )
+    errors, count, typed = _inspect("synthetic.py", tree)
+    assert count == 1 and typed == 0
+    assert len(errors) == 1
+
+
+def test_string_only_inventory_stays_within_canonical_baseline() -> None:
+    baseline = _load_baselines()["test_planning_branch_context"]
+    assert len(_CODE_ONLY) <= baseline["code_only_consumers"]
+    assert len(_CONTEXTLESS) <= baseline["contextless_seams"]
+
+
+@pytest.mark.parametrize("symbol", ["_CODE_ONLY", "_CONTEXTLESS"])
+def test_canonical_ratchet_rejects_growth_of_each_exception_inventory(monkeypatch: pytest.MonkeyPatch, symbol: str) -> None:
+    import sys
+    from tests.architectural.test_ratchet_baselines import test_growing_an_allowlist_above_baseline_fails
+
+    module = sys.modules[__name__]
+    original = getattr(module, symbol)
+    monkeypatch.setattr(module, symbol, {**original, ("synthetic.py", "new_consumer"): "planted growth"})
+    with pytest.raises(AssertionError, match=f"test_planning_branch_context.{symbol}"):
+        test_growing_an_allowlist_above_baseline_fails()
