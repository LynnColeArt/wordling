+@pytest.mark.parametrize("wp", ["WP01", "WP02", "WP03"])
+def test_public_context_retains_actual_kind_and_target(public_stage_mission: tuple[Path, LanesManifest], wp: str) -> None:
+    root, manifest = public_stage_mission
+    lane = manifest.lane_for_wp(wp)
+    assert lane is not None
+    context = resolve_context(wp, "stages", "codex", root)
+    expected_ref = manifest.target_branch if is_planning_lane(lane) else lane_branch_name("stages", lane.lane_id, lane=lane)
+    assert load_context(context.token, root).to_dict() == context.to_dict()
+    assert context.authoritative_ref == expected_ref
+    assert context.authoritative_repo == str(root)
+    assert context.execution_mode == lane.execution_mode
+    assert context.work_package_id == wp
+    assert context.dependency_mode == ("independent" if wp == "WP01" else "chained")
+
+
+def test_public_topology_includes_all_typed_stages_and_code_control(public_stage_mission: tuple[Path, LanesManifest]) -> None:
+    root, manifest = public_stage_mission
+    topology = materialize_worktree_topology(root, "stages")
+    assert [entry.wp_id for entry in topology.entries] == ["WP01", "WP02", "WP03"]
+    assert topology.target_branch == "release/test"
+    assert topology.has_stacking
+    for entry in topology.entries:
+        lane = manifest.lane_for_wp(entry.wp_id)
+        assert lane is not None
+        planning = is_planning_lane(lane)
+        assert entry.execution_mode == lane.execution_mode
+        assert entry.lane_id == lane.lane_id
+        assert entry.lane_wp_ids == list(lane.wp_ids)
+        assert entry.resolution_kind == ("repo_root" if planning else "lane_workspace")
+        assert entry.branch_name == (manifest.target_branch if planning else lane_branch_name("stages", lane.lane_id, lane=lane))
+        assert entry.worktree_exists == planning
+    rendered = json.loads(render_topology_json(topology, "WP03")[1])
+    assert [entry["lane_id"] for entry in rendered["entries"]] == ["lane-planning", "lane-a", "lane-planning-stage-2"]
