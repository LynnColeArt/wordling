  "seams": {
    "storage_new": [
      "Directory.PrepareNewPublication(target *Destination, data []byte, id PublicationID) (*NewPublication, error)",
      "Directory.PublishNew(p *NewPublication, expectedID PublicationID) (Outcome, error)"
    ],
    "storage_preserved": [
      "PreparePublication requires real source from same Directory",
      "Publish requires sourced Publication",
      "Save sourced no-op/absent-target behavior unchanged",
      "Macro.Image private wrapper34 preserved"
    ],
    "document_proposed": [
      "Document.Origin() Origin; opaque comparable lineage and inspectable Loaded/New kind",
      "New(config NewConfig) (*Document,error); config fields wait for D",
      "OriginalExport returns NoLoadedOriginal for constructed lineage, even after first save",
      "Revision remains opaque private state identity"
    ],
    "editor_proposed": [
      "private immutable birth Origin separate from retained source guard, displayed name and last-publication receipt",
      "never-published New lineage without an acquired anchor alone selects unsourced worker",
      "first never-sourced New publication plus exact storage.Read binding establishes its retained source guard without replacing native revision/history",
      "later sourced Save As updates displayed name/last-publication receipt while retaining original loaded source or New first anchor; no implicit Read/rebind",
      "existing same-file no-op and cross-directory Save/PreparePublication constraints preserved"
    ],
    "prepared_capture_clarification": {
      "source": "immutable accepted original source name/full identity/native image plus stable private acquired capability; preserve all old freshness checks",
      "destination": "immutable exact accepted name/observation plus stable capability",
      "receiver": "stable private opened capability; rebound/zero/closed receiver refuses before filesystem IO",
      "close": "shared actual capability lifetime across legitimate copies; no hidden duplicated/reopened resource",
      "new_type": "same target/root capture without source",
      "synchronous_Save": "preserve approved cross-directory and no-op/no-replace semantics",
      "concurrent_during_calls": "outside guarantee; sequential between-call wrapper replacement covered"
    }
