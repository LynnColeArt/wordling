{
  "scope": "all actual candidate/control/preflight comparison call branches, not unused imported runner CLIs",
  "branches": [
    {
      "caller": "wordling_edits.check_plan/prepared_candidate",
      "reads": [
        "selected-preparation.json",
        "plan.json",
        "root grant",
        "Go/module and helper sources/toolchain",
        "all declared CANDIDA/provenance/expectations/source/reference paths",
        "history-control-seal and raw control PRN",
        "bound history expectations"
      ],
      "preflight": "validate actual resolved path+identity, no new expected values"
    },
    {
      "caller": "candidate_mode.compare\u2192relationships.compare",
      "reads": [
        "n.OUT/field-ledger.json",
        "source native",
        "retrieved/edited/after_print native"
      ],
      "configuration_problem": "redirected n.OUT missing exact approved schema"
    },
    {
      "caller": "candidate_mode.compare\u2192classify_reader.classify",
      "reads": [
        "classify_reader.HERE/reader_probe.go.txt",
        "ROOT/internal/wp51/native.go",
        "actual go.mod/wp51 imports",
        "native exports"
      ],
      "writes": [
        "bounded temp source within HERE",
        "Go tool caches"
      ],
      "preflight": "stage/check bridge and writable temp parent BEFORE controls"
    },
    {
      "caller": "control_compare/candidate_mode.compare\u2192final_state.require_final_state",
      "reads": [
        "final_state.HERE/final-state-golden.json",
        "three ROOT/identity.path goldens",
        "actual clean-exit screen.txt/vram.bin/cursor.json"
      ],
      "preflight": "all exact golden pins and correct module HERE/ROOT"
    },
    {
      "caller": "n.execute/settings/custom\u2192session.configure/guest.start/QMP/finish_original",
      "reads": [
        "private masters/profile-defined QEMU+firmware",
        "same session1.lock",
        "fresh work/seed/runtime paths",
        "executing helper source archive glob",
        "candidate inputs/reference",
        "owned /proc pid/stat/cmdline"
      ],
      "generated": [
        "runtime socket/pid",
        "QMP raw captures/inspect/trace",
        "poststop native/PRN exports/resource hashes/master reconciliation"
      ],
      "note": "private HDs not read in diagnosis; static called-branch audit only"
    },
    {
      "caller": "validate_owned_run/candidate_mode.compare/control_compare",
      "reads": [
        "run.json/artifact manifests",
        "owned-pid/owned-stop",
        "profile/master receipts",
        "candidate_source_path",
        "all native/PRN/settings/job-status/finalDOS artifacts"
      ],
      "preflight": "declare postconditions for future generated files; fail first missing/drift"
    }
  ],
  "unused_on_this_branch": [
    "native-edits/case-ledger.json",
    "native_edits.ORIGIN",
    "session1.FIXTURE/fixture writer",
    "macro_session fixture generators",
    "legacy text_layout main runner"
  ],
  "approved_helpers_unchanged": true,
  "no_guest_calls_executed": true
}
