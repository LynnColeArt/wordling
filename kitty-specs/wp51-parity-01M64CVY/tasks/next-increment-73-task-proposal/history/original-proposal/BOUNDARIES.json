{
  "schema": "wordling.character-repeat.task-boundaries/v1",
  "routing_authoritative_surface": "internal/tui/",
  "routing_owned_namespace": "internal/tui/**",
  "routing_is_not_write_authority": true,
  "amend_existing": [
    "internal/tui/model.go",
    "internal/tui/macro_model.go",
    "internal/tui/menu_bar.go",
    "internal/tui/ascii_viewport.go",
    "internal/tui/reveal_inspection.go",
    "internal/tui/README.md"
  ],
  "create_files": [
    "internal/tui/character_repeat.go",
    "internal/tui/character_repeat_test.go"
  ],
  "create_namespaces": [
    "internal/tui/evidence/character-repeat/"
  ],
  "namespace_payload_drivers_exact": [
    "internal/tui/evidence/character-repeat/run_pty.py",
    "internal/tui/evidence/character-repeat/mutants.py",
    "internal/tui/evidence/character-repeat/collect.py"
  ],
  "namespace_other_payloads": "Bounded raw evidence/reports/JSON/text/native emitted outputs/history/nested seals only; no imported Go package/product Go file, hidden source/test edits or generic new tool framework. Drivers optional if existing approved read-only utility suffices; no other executable literal without reviewed amendment.",
  "old_test_amendments": [],
  "protected_no_change": [
    "cmd/",
    "internal/input/",
    "internal/editor/",
    "internal/document/",
    "internal/storage/",
    "internal/macro/",
    "go.mod",
    "go.sum",
    "all inherited tests/fixtures/evidence except none",
    "canonical planning/runtime/lifecycle"
  ],
  "proposed_dependency": "actual CODE-approved WP71 source; G65 inherited, no moving70/72",
  "limits": {
    "count_min": 1,
    "count_max": 9,
    "digit_count": 1,
    "expanded_bytes_max": 9,
    "isolated_expansion_allocated_bytes_max": 256,
    "three_key_public_sequence_allocated_bytes_max": 1048576,
    "pending_View_allocated_bytes_max": 131072,
    "allocation_measurement_samples_max": 100,
    "model_cases_max": 48,
    "events_per_model_case_max": 128,
    "compiled_semantic_mutants_max": 12,
    "baseline_PTYs": 2,
    "integration_mutant_PTYs_max": 2,
    "PTY_seconds": 30,
    "cleanup_seconds": 2,
    "PTY_combined_wire_stderr_bytes_max": 2097152,
    "Go_or_configured_command_seconds_max": 300,
    "evidence_files_max": 256,
    "evidence_bytes_max": 6291456
  },
  "claim_requirements": [
    "actual clean issued H source and compiler/module/GoFiles/fixture/evidence closure",
    "exact old/new changed-path set including deletion/rename",
    "late actual source/binary/observer hash binding",
    "fresh normal CURRENT analysis/issued claim",
    "ROOT classification of any changed prerequisite before implementation",
    "independent TASK then CODE review"
  ],
  "no_reserved_ids": true
}
