      "path": "/home/lynn/.local/share/uv/tools/spec-kitty-cli/lib/python3.13/site-packages/specify_cli/ownership/frontmatter_source.py",
      "bytes": 4286,
      "sha256": "cdf4d98e300bede672a3e1e7fef4c853128de5784f435abaa3fa5749dcfa3314",
      "blocks": [
        {
          "start": 1,
          "end": 113,
          "lines": [
            "1: \"\"\"Frontmatter-source port for ownership resolve→validate (FR-031, epic #1666).",
            "2: ",
            "3: The pure seam :func:`specify_cli.ownership.validation.build_wp_manifests` turns a",
            "4: ``Mapping[str, WPMetadata]`` into ownership manifests. Historically the finalize",
            "5: caller owned the *acquisition* of that mapping inline — disk reads via",
            "6: ``read_wp_frontmatter`` plus the in-memory (``_inmemory_frontmatter``)",
            "7: substitution that validate-only mode requires — so the whole resolve→validate",
            "8: path could only be exercised by stubbing the reader or writing temp files.",
            "9: ",
            "10: This module introduces a single owning port: a :class:`FrontmatterSource`",
            "11: supplies WP frontmatter, and :func:`resolve_wp_manifests` drives it through the",
            "12: pure seam. Tests can construct an :class:`InMemoryFrontmatterSource` from plain",
            "13: ``WPMetadata`` stubs and run the full overlap/exemption decision with no reader",
            "14: mocking and no filesystem. The finalize command routes through",
            "15: :class:`FinalizeFrontmatterSource`, which preserves the existing",
            "16: prefer-in-memory-then-disk behavior (behavior-preserving refactor, NFR-003).",
            "17: \"\"\"",
            "18: ",
            "19: from __future__ import annotations",
            "20: ",
            "21: import contextlib",
            "22: import re",
            "23: from pathlib import Path",
            "24: from typing import TYPE_CHECKING, Protocol",
            "25: ",
            "26: from specify_cli.ownership.models import OwnershipManifest",
            "27: from specify_cli.ownership.validation import build_wp_manifests",
            "28: ",
            "29: if TYPE_CHECKING:",
            "30:     from collections.abc import Mapping",
            "31: ",
            "32:     from specify_cli.status import WPMetadata",
            "33: ",
            "34: __all__ = [",
            "35:     \"FinalizeFrontmatterSource\",",
            "36:     \"resolve_wp_manifests\",",
            "37: ]",
            "38: ",
            "39: _WP_ID_RE = re.compile(r\"^(WP\\d{2})(?:[-_.]|$)\")",
            "40: ",
            "41: ",
            "42: class FrontmatterSource(Protocol):",
            "43:     \"\"\"Supplies WP frontmatter keyed by WP id, ready for manifest resolution.\"\"\"",
            "44: ",
            "45:     def frontmatters(self) -> Mapping[str, WPMetadata]:",
            "46:         \"\"\"Return a mapping of WP id (e.g. ``\"WP01\"``) to its ``WPMetadata``.\"\"\"",
            "47:         ...",
            "48: ",
            "49: ",
            "50: class InMemoryFrontmatterSource:",
            "51:     \"\"\"Frontmatter source backed entirely by an in-memory mapping.",
            "52: ",
            "53:     Intended for tests and any caller that already holds resolved",
            "54:     ``WPMetadata`` — no disk access, no reader stubbing.",
            "55:     \"\"\"",
            "56: ",
            "57:     def __init__(self, frontmatters: Mapping[str, WPMetadata]) -> None:",
            "58:         self._frontmatters: dict[str, WPMetadata] = dict(frontmatters)",
            "59: ",
            "60:     def frontmatters(self) -> Mapping[str, WPMetadata]:",
            "61:         return self._frontmatters",
            "62: ",
            "63: ",
            "64: class FinalizeFrontmatterSource:",
            "65:     \"\"\"Finalize-time source: in-memory snapshots win, disk is the fallback.",
            "66: ",
            "67:     Mirrors the finalize-tasks ownership block: validate-only mode bootstraps",
            "68:     frontmatter in memory without writing to disk, so any WP present in",
            "69:     ``inmemory`` must use that snapshot; WPs absent from it are read from disk",
            "70:     via ``read_wp_frontmatter``. WPs with unreadable frontmatter are skipped,",
            "71:     preserving the existing ``contextlib.suppress(Exception)`` behavior.",
            "72:     \"\"\"",
            "73: ",
            "74:     def __init__(",
            "75:         self,",
            "76:         wp_files: list[Path],",
            "77:         inmemory: Mapping[str, WPMetadata],",
            "78:     ) -> None:",
            "79:         self._wp_files = list(wp_files)",
            "80:         self._inmemory: dict[str, WPMetadata] = dict(inmemory)",
            "81: ",
            "82:     def frontmatters(self) -> Mapping[str, WPMetadata]:",
            "83:         from specify_cli.status import read_wp_frontmatter",
            "84: ",
            "85:         resolved: dict[str, WPMetadata] = {}",
            "86:         for wp_file in self._wp_files:",
            "87:             match = _WP_ID_RE.match(wp_file.name)",
            "88:             if not match:",
            "89:                 continue",
            "90:             wp_id = match.group(1)",
            "91:             with contextlib.suppress(Exception):  # Skip unreadable frontmatter",
            "92:                 if wp_id in self._inmemory:",
            "93:                     resolved[wp_id] = self._inmemory[wp_id]",
            "94:                 else:",
            "95:                     meta, _body = read_wp_frontmatter(wp_file)",
            "96:                     resolved[wp_id] = meta",
            "97:         return resolved",
            "98: ",
            "99: ",
            "100: def resolve_wp_manifests(source: FrontmatterSource) -> dict[str, OwnershipManifest]:",
            "101:     \"\"\"Resolve ownership manifests from a frontmatter source.",
            "102: ",
            "103:     This is the one entry point that joins frontmatter acquisition (the port)",
            "104:     to the pure validation seam, so the full resolve→validate path is testable",
            "105:     end-to-end with a plain stub source.",
            "106: ",
            "107:     Args:",
            "108:         source: A :class:`FrontmatterSource` supplying WP frontmatter.",
            "109: ",
            "110:     Returns:",
            "111:         Mapping of WP id to ``OwnershipManifest`` for WPs that declare ownership.",
            "112:     \"\"\"",
            "113:     return build_wp_manifests(source.frontmatters())"
          ]
        }
      ]
    },
    {
      "path": "/home/lynn/.local/share/uv/tools/spec-kitty-cli/lib/python3.13/site-packages/specify_cli/ownership/models.py",
      "bytes": 4781,
      "sha256": "026104dd7600e1fbd78f0eb2d0d487c270ca53e1a5f08d341dbe62cd1ab45d37",
      "blocks": [
        {
          "start": 1,
          "end": 126,
          "lines": [
            "1: \"\"\"Ownership manifest models for spec-kitty work packages.",
            "2: ",
            "3: Defines WorkProductKind (StrEnum) and OwnershipManifest (frozen dataclass)",
            "4: representing the ownership profile of a single work package.",
            "5: \"\"\"",
            "6: ",
            "7: from __future__ import annotations",
            "8: ",
            "9: from dataclasses import dataclass",
            "10: from enum import StrEnum",
            "11: from typing import TYPE_CHECKING, Any",
            "12: ",
            "13: if TYPE_CHECKING:",
            "14:     from specify_cli.status import WPMetadata",
            "15: ",
            "16: ",
            "17: # Sentinel for the codebase-wide scope value used in WP frontmatter.",
            "18: SCOPE_CODEBASE_WIDE = \"codebase-wide\"",
            "19: ",
            "20: ",
            "21: class WorkProductKind(StrEnum):",
            "22:     \"\"\"Execution mode of a work package.",
            "23: ",
            "24:     Exactly two values:",
            "25:     - code_change: The WP produces source-code or test changes.",
            "26:     - planning_artifact: The WP produces planning/documentation artifacts only.",
            "27:     \"\"\"",
            "28: ",
            "29:     CODE_CHANGE = \"code_change\"",
            "30:     PLANNING_ARTIFACT = \"planning_artifact\"",
            "31: ",
            "32: ",
            "33: @dataclass(frozen=True)",
            "34: class OwnershipManifest:",
            "35:     \"\"\"Ownership profile embedded in a work package's frontmatter.",
            "36: ",
            "37:     Attributes:",
            "38:         execution_mode: Whether this WP changes code or produces planning artifacts.",
            "39:         owned_files: Tuple of glob patterns describing files owned by this WP.",
            "40:         authoritative_surface: Path prefix that is the primary surface owned by",
            "41:             this WP (e.g. ``src/specify_cli/ownership/``).",
            "42:         scope: Optional scope declaration. When set to ``\"codebase-wide\"``, the WP",
            "43:             is an audit/cutover WP that legitimately touches the entire repository.",
            "44:             Ownership validation is relaxed for such WPs.",
            "45:     \"\"\"",
            "46: ",
            "47:     execution_mode: WorkProductKind",
            "48:     owned_files: tuple[str, ...]  # Glob patterns",
            "49:     authoritative_surface: str  # Path prefix",
            "50:     scope: str | None = None  # \"codebase-wide\" or None (narrow/default)",
            "51: ",
            "52:     @property",
            "53:     def is_codebase_wide(self) -> bool:",
            "54:         \"\"\"Return True if this WP has codebase-wide scope.\"\"\"",
            "55:         return self.scope == SCOPE_CODEBASE_WIDE",
            "56: ",
            "57:     @classmethod",
            "58:     def from_frontmatter(cls, data: dict[str, Any] | WPMetadata) -> OwnershipManifest:",
            "59:         \"\"\"Construct an OwnershipManifest from parsed frontmatter data.",
            "60: ",
            "61:         Args:",
            "62:             data: Either a :class:`WPMetadata` instance or a raw dictionary",
            "63:                 with keys ``execution_mode``, ``owned_files``, and",
            "64:                 ``authoritative_surface``. Optionally ``scope``.",
            "65: ",
            "66:         Returns:",
            "67:             A new OwnershipManifest instance.",
            "68: ",
            "69:         Raises:",
            "70:             KeyError: If a required key is missing.",
            "71:             ValueError: If ``execution_mode`` is not a valid WorkProductKind value.",
            "72:         \"\"\"",
            "73:         from specify_cli.status import WPMetadata",
            "74: ",
            "75:         if isinstance(data, WPMetadata):",
            "76:             # Normalize to a dict and fall through to the single extraction path.",
            "77:             # Two contracts must be preserved through the normalization:",
