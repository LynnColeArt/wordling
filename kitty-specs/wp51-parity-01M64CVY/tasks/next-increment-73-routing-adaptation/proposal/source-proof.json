            "161: def validate_no_overlap(",
            "162:     manifests: dict[str, OwnershipManifest],",
            "163:     dependencies: Mapping[str, list[str]] | None = None,",
            "164: ) -> list[str]:",
            "165:     \"\"\"Check that no two *concurrent* WPs have overlapping owned_files patterns.",
            "166: ",
            "167:     Codebase-wide WPs are excluded (they are expected to overlap with",
            "168:     everything). When *dependencies* is supplied, **same-lane sequential** WPs —",
            "169:     those with a directed dependency path between them — are also exempt: a",
            "170:     linearized refactor chain shares one execution worktree and runs in",
            "171:     dependency order, so two such WPs legitimately own the same files. The",
            "172:     no-overlap guard exists to stop *parallel* (dependency-unordered) WPs from",
            "173:     colliding, so only concurrent pairs are flagged. When *dependencies* is",
            "174:     ``None`` the legacy all-pairs behaviour is preserved.",
            "175: ",
            "176:     Args:",
            "177:         manifests: Mapping of WP ID (e.g. ``\"WP01\"``) to its OwnershipManifest.",
            "178:         dependencies: Optional mapping of WP ID to the WP ids it depends on.",
            "179:             Used to exempt sequential (same-lane) pairs from the overlap check.",
            "180: ",
            "181:     Returns:",
            "182:         List of error messages.  Empty list means no disallowed overlaps.",
            "183:     \"\"\"",
            "184:     errors: list[str] = []",
            "185: ",
            "186:     # Filter out codebase-wide WPs -- they are allowed to overlap with anything.",
            "187:     narrow_manifests = {",
            "188:         wp_id: m for wp_id, m in manifests.items() if not m.is_codebase_wide",
            "189:     }",
            "190:     skipped = set(manifests.keys()) - set(narrow_manifests.keys())",
            "191:     for wp_id in sorted(skipped):",
            "192:         logger.info(\"Skipping overlap check for %s (codebase-wide scope)\", wp_id)",
            "193: ",
            "194:     reach = _dependency_reachability(dependencies) if dependencies else {}",
            "195: ",
            "196:     wp_ids = list(narrow_manifests.keys())",
            "197: ",
            "198:     for wp_a, wp_b in combinations(wp_ids, 2):",
            "199:         # Same-lane sequential pair (a directed dependency path exists either",
            "200:         # way) → never concurrent → sharing owned_files is legitimate.",
            "201:         if reach and (wp_b in reach.get(wp_a, ()) or wp_a in reach.get(wp_b, ())):",
            "202:             logger.info(",
            "203:                 \"Skipping overlap check for sequential pair %s/%s (dependency-ordered)\",",
            "204:                 wp_a,",
            "205:                 wp_b,",
            "206:             )",
            "207:             continue",
            "208: ",
            "209:         manifest_a = narrow_manifests[wp_a]",
            "210:         manifest_b = narrow_manifests[wp_b]",
            "211: ",
            "212:         for glob_a in manifest_a.owned_files:",
            "213:             for glob_b in manifest_b.owned_files:",
            "214:                 if _globs_overlap(glob_a, glob_b):",
            "215:                     errors.append(",
            "216:                         f\"Overlap: {wp_a} ({glob_a!r}) and {wp_b} ({glob_b!r}) \"",
            "217:                         f\"claim overlapping paths.\"",
            "218:                     )",
            "219: ",
            "220:     return errors"
          ]
        },
        {
          "start": 223,
          "end": 252,
          "lines": [
            "223: def validate_authoritative_surface(manifest: OwnershipManifest) -> list[str]:",
            "224:     \"\"\"Check that authoritative_surface is a prefix of at least one owned_files entry.",
            "225: ",
            "226:     Codebase-wide WPs are skipped -- they may have broad authoritative_surface",
            "227:     values like ``\"/\"`` that do not follow the narrow prefix convention.",
            "228: ",
            "229:     Args:",
            "230:         manifest: The OwnershipManifest to validate.",
            "231: ",
            "232:     Returns:",
            "233:         List of error messages.  Empty list means the manifest is valid.",
            "234:     \"\"\"",
            "235:     if manifest.is_codebase_wide:",
            "236:         return []",
            "237: ",
            "238:     errors: list[str] = []",
            "239:     surface = manifest.authoritative_surface",
            "240: ",
            "241:     if not surface:",
            "242:         errors.append(\"authoritative_surface is empty.\")",
            "243:         return errors",
            "244: ",
            "245:     for pattern in manifest.owned_files:",
            "246:         if pattern == surface or pattern.startswith(surface):",
            "247:             return []  # At least one match — valid",
            "248: ",
            "249:     errors.append(",
            "250:         f\"authoritative_surface {surface!r} is not a prefix of any owned_files entry: \"",
            "251:         f\"{list(manifest.owned_files)!r}\"",
            "252:     )"
          ]
        },
