            "282:     Args:",
            "283:         manifests: Mapping of WP ID to OwnershipManifest.",
            "284: ",
            "285:     Returns:",
            "286:         List of (wp_a, wp_b) tuples with overlapping write scopes.",
            "287:     \"\"\"",
            "288:     pairs: list[tuple[str, str]] = []",
            "289:     wp_ids = sorted(manifests.keys())",
            "290:     for wp_a, wp_b in combinations(wp_ids, 2):",
            "291:         for glob_a in manifests[wp_a].owned_files:",
