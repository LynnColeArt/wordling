            "384: def validate_glob_matches(",
            "385:     manifests: dict[str, OwnershipManifest],",
            "386:     repo_root: Path,",
            "387:     create_intent: dict[str, list[str]] | None = None,",
            "388: ) -> GlobValidationResult:",
            "389:     \"\"\"Check owned_files entries against the repository for zero-match conditions.",
            "390: ",
            "391:     Classifies each entry as a literal path or a glob pattern, then applies",
            "392:     different severity rules:",
            "393: ",
            "394:     - **Literal path + zero matches** → hard error (exit 1), with a",
            "395:       nearest-match suggestion when one can be found.  Suppressed (becomes an",
            "396:       info note) when the path appears in *create_intent* for that WP.",
            "397:     - **Glob pattern + zero matches** → soft warning (may be in-flight work).",
            "398: ",
            "399:     Args:",
            "400:         manifests: Mapping of WP ID to OwnershipManifest.",
            "401:         repo_root: Root directory of the repository for glob resolution.",
            "402:         create_intent: Optional mapping of WP ID → list of paths that are",
            "403:             planned-new-file entries.  A literal-path zero-match whose path",
            "404:             appears in this list is suppressed (no hard error).",
            "405: ",
            "406:     Returns:",
            "407:         :class:`GlobValidationResult` with separate ``errors``, ``warnings``,",
            "408:         and ``info`` lists.  Call sites should emit ``errors`` to stderr and",
            "409:         exit 1 if ``result.passed`` is False.",
            "410:     \"\"\"",
            "411:     _create_intent: dict[str, list[str]] = create_intent or {}",
            "412:     result = GlobValidationResult()",
            "413: ",
            "414:     for wp_id in sorted(manifests):",
            "415:         manifest = manifests[wp_id]",
            "416:         wp_intent_paths = set(_create_intent.get(wp_id, []))",
            "417: ",
            "418:         for pattern in manifest.owned_files:",
            "419:             matched = any(repo_root.glob(pattern))",
            "420:             if matched:",
            "421:                 continue",
            "422: ",
            "423:             if is_glob_pattern(pattern):",
            "424:                 # Glob zero-match → soft warning only",
            "425:                 result.warnings.append(",
            "426:                     f\"{wp_id}: owned_files glob '{pattern}' matches \"",
            "427:                     f\"zero files in the repository\"",
            "428:                 )",
            "429:             elif pattern in wp_intent_paths:",
            "430:                 # Literal path suppressed by create_intent",
            "431:                 result.info.append(",
            "432:                     f\"{wp_id}: owned_files path '{pattern}' has no match \"",
            "433:                     f\"— suppressed by create_intent (planned-new-file).\"",
            "434:                 )",
            "435:             else:",
            "436:                 # Literal path zero-match → hard error",
            "437:                 suggestion = _nearest_match_suggestion(pattern, repo_root)",
            "438:                 msg = (",
            "439:                     f\"{wp_id}: owned_files path '{pattern}' is a literal \"",
            "440:                     f\"file path that matches zero files in the repository.\"",
            "441:                 )",
            "442:                 if suggestion:",
            "443:                     msg += f\" {suggestion}\"",
            "444:                 msg += (",
            "445:                     \" If this file will be created during implementation, \"",
            "446:                     f\"declare it in the WP frontmatter:\\n  create_intent:\\n    - {pattern}\"",
            "447:                 )",
            "448:                 result.errors.append(msg)",
            "449: ",
            "450:     return result"
          ]
        }
      ]
    },
