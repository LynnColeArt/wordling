+def _lane_suffix(index: int) -> str:
+    """Return bijective lowercase suffixes, preserving the first 26 lane IDs."""
+    if index < 0:
+        raise ValueError("lane index must be nonnegative")
+    suffix = ""
+    value = index + 1
+    while value:
+        value, remainder = divmod(value - 1, 26)
+        suffix = chr(ord("a") + remainder) + suffix
+    return suffix
 
 
